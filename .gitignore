# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv310/
venv/
env/

# --- Virtual env / tooling dirs (large, machine-specific) ---
.opencode/
.claude/

# --- Large data / build artifacts ---
# A take's metadata is small and is the fixture tests/run_tests.py measures, so it
# belongs in the repo; the recorded video (86 MB a take) does not.
videos/**
!videos/**/
!videos/*/*_poses.jsonl
!videos/*/data_room.json
!videos/*/calibration.json
work/
scratch/

# --- tools/: keep binaries, exclude redundant archives (over GitHub's 100MB/file limit) ---
tools/colmap.zip
tools/ffmpeg.zip

# --- Secrets / certificates ---
*.pem
*.key
*.crt

# --- Video production & media workspace ---
video_production/film/renders/*.mp4
video_production/rig/.chrome-profile/
video_production/raw/
video_production/film/assets/cut/
video_production/film/assets/video/
video_production/film/.thumbnails/
.thumbnails/

# --- Retained local final outcomes (never commit to git) ---
se_lab/
ppt/

# --- Outputs / temp files ---
*.log
*.tmp
.DS_Store
Thumbs.db

# --- IDE / editor ---
.vscode/
.idea/

# --- Node (viewer deps, if any) ---
node_modules/

# --- EGM96 geoid grid (F3): public-domain NGA data, fetched on demand ---
# curl -L -o data/geoid/us_nga_egm96_15.tif https://cdn.proj.org/us_nga_egm96_15.tif
data/geoid/*.tif

# --- Local scratch tests, intermediate decks, and git worktrees ---
gputest/
deck_render/
deck_inspect/
ref_crops/
.wt/
_archived_workspaces/
data/textures/
